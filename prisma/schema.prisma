// KRUMBISTRY Bake Shop — Prisma Schema
// Database: Neon PostgreSQL

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  BANK_TRANSFER
  ONLINE
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
}

enum CustomOrderStatus {
  NEW
  UNDER_REVIEW
  QUOTED
  CONFIRMED
  IN_PRODUCTION
  COMPLETED
  DECLINED
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  RESPONDED
  CLOSED
}

model Admin {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  role         AdminRole  @default(SUPER_ADMIN)
  active       Boolean    @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([email])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  active      Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([slug])
  @@index([active, sortOrder])
}

model Product {
  id              String      @id @default(cuid())
  name            String
  slug            String      @unique
  shortDescription String
  description     String      @db.Text
  price           Decimal     @db.Decimal(10, 2)
  salePrice       Decimal?    @db.Decimal(10, 2)
  sku             String      @unique
  categoryId      String
  category        Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  mainImage       String
  gallery         String[]    @default([])
  ingredients     String[]    @default([])
  allergens       String[]    @default([])
  size            String?
  weight          String?
  servings        String?
  preparationTime String?
  featured        Boolean     @default(false)
  bestseller      Boolean     @default(false)
  available       Boolean     @default(true)
  published       Boolean     @default(true)
  sortOrder       Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  orderItems      OrderItem[]

  @@index([slug])
  @@index([categoryId])
  @@index([featured, published])
  @@index([bestseller, published])
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  customerName    String
  customerEmail   String
  customerPhone   String
  deliveryAddress String        @db.Text
  customerNotes   String?       @db.Text
  status          OrderStatus   @default(PENDING)
  paymentMethod   PaymentMethod @default(CASH_ON_DELIVERY)
  paymentStatus   PaymentStatus @default(UNPAID)
  subtotal        Decimal       @db.Decimal(10, 2)
  deliveryFee     Decimal       @db.Decimal(10, 2)
  total           Decimal       @db.Decimal(10, 2)
  internalNotes   String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  items           OrderItem[]

  @@index([orderNumber])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName     String
  productSku      String
  unitPrice       Decimal  @db.Decimal(10, 2)
  quantity        Int
  totalPrice      Decimal  @db.Decimal(10, 2)
  selectedOptions String?  @db.Text
  notes           String?  @db.Text

  @@index([orderId])
  @@index([productId])
}

model CustomOrder {
  id                String            @id @default(cuid())
  referenceCode     String            @unique
  customerName      String
  email             String
  phone             String
  eventType         String
  eventDate         DateTime
  deliveryDate      DateTime
  servings          String
  cakeSize          String
  flavor            String
  filling           String?
  designDescription String            @db.Text
  budgetRange       String
  referenceImages   String[]          @default([])
  status            CustomOrderStatus @default(NEW)
  quotedPrice       Decimal?          @db.Decimal(10, 2)
  internalNotes     String?           @db.Text
  notes             String?           @db.Text
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([referenceCode])
  @@index([status])
  @@index([deliveryDate])
}

model Inquiry {
  id            String        @id @default(cuid())
  name          String
  email         String
  phone         String?
  subject       String
  message       String        @db.Text
  status        InquiryStatus @default(NEW)
  internalNotes String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Testimonial {
  id             String   @id @default(cuid())
  customerName   String
  roleOrLocation String?  @default("Valued Customer")
  content        String   @db.Text
  rating         Int      @default(5)
  verified       Boolean  @default(true)
  published      Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([published, sortOrder])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@index([key])
}

model UploadedAsset {
  id        String   @id @default(cuid())
  publicId  String   @unique
  secureUrl String
  format    String?
  width     Int?
  height    Int?
  bytes     Int?
  folder    String?
  createdAt DateTime @default(now())

  @@index([publicId])
}

